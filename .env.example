# Copy to .env. Read at startup from the **current working directory**, which is
# why everything is run from the repo root.
#
# Precedence, highest first:
#   1. values set in the running app (Settings panel / PUT /api/settings) —
#      in-memory only, gone on restart
#   2. the process environment
#   3. this file
#   4. the defaults in designagent/config.py
#
# `python -m designagent --check-config` prints what is actually in effect, with
# secrets masked; add `--probe` to try each credential against its service.

# --- LLM ---
# Without a key the agent still runs: every node falls back to deterministic,
# rule-based behaviour (see designagent/llm.py).
ANTHROPIC_API_KEY=
DESIGNAGENT_MODEL=claude-sonnet-5-5
DESIGNAGENT_MAX_TOKENS=2048

# --- storage ---
DESIGNAGENT_DATA_DIR=./data

# --- compute ---
DESIGNAGENT_POOL_WORKERS=4
# Ceiling for one local task. A batch job gets its own, derived from the job's
# walltime, so a queued job is not failed before the scheduler starts it.
DESIGNAGENT_TASK_TIMEOUT_SEC=900

# --- Orbit (remote HPC workflows) ---
# Point at a real broker, or set DESIGNAGENT_ORBIT_LOCAL=true to have the server
# start a localhost broker + endpoint itself (development only: that broker runs
# with ingress auth off, though it still serves TLS).
DESIGNAGENT_ORBIT_ENABLED=false
DESIGNAGENT_ORBIT_LOCAL=false
RADICAL_ORBIT_BROKER_URL=
RADICAL_ORBIT_BROKER_TOKEN=
# Required whenever the broker URL is https/wss. Falls back to
# ~/.radical/orbit/broker_cert.pem when unset.
RADICAL_ORBIT_BROKER_CERT=
# A substring hint, not an id: the first endpoint matching it is used.
DESIGNAGENT_ORBIT_ENDPOINT=

# What the far end runs with. Empty backends means the endpoint's own default
# (dragon_v3); the dev stack uses `concurrent`.
DESIGNAGENT_ORBIT_RHAPSODY_BACKENDS=
# PSI/J executor: local, slurm, pbspro, lsf, cobalt…
DESIGNAGENT_ORBIT_PSIJ_EXECUTOR=local
# Empty means "auto-discover at the endpoint".
DESIGNAGENT_ORBIT_ACCOUNT=
DESIGNAGENT_ORBIT_QUEUE=
DESIGNAGENT_ORBIT_JOB_DURATION_SEC=1800
DESIGNAGENT_ORBIT_CLIENT_NAME=designagent
DESIGNAGENT_ORBIT_CONNECT_TIMEOUT=30
# A job returns files through its stdout, because the broker forwards neither
# `outputs` nor `stdin_text` (see tasks/hpc/artifacts.py). These bound that
# channel: per staged file, and per job in total.
DESIGNAGENT_ORBIT_ARTIFACT_MAX_BYTES=1048576
DESIGNAGENT_ORBIT_JOB_OUTPUT_MAX_BYTES=4194304
# GPUs per job. 0 omits the resource key entirely rather than requesting zero,
# which is what a CPU-only local run wants.
DESIGNAGENT_ORBIT_JOB_GPUS=1

# --- ProteinMPNN ------------------------------------------------------------
# A command string, not a path, so it spells a local CPU install and a site's
# module-loaded one equally well. See scripts/setup_mpnn.sh --check.
DESIGNAGENT_MPNN_COMMAND=protein_mpnn_run.py
# Shell run before the command at the far end.
DESIGNAGENT_MPNN_PROLOGUE=
DESIGNAGENT_MPNN_SAMPLING_TEMP=0.1

# --- Globus Compute ---
# Never run against a live endpoint, and `globus-compute-sdk` is not installed.
# Credentials come from the SDK's own login, not from here.
DESIGNAGENT_GLOBUS_ENABLED=false
DESIGNAGENT_GLOBUS_ENDPOINT_ID=

# --- serving ---
# Required to change settings over HTTP when the server is not bound to
# loopback. Unset plus a loopback bind is the development default.
DESIGNAGENT_ADMIN_TOKEN=

# --- structure prediction ---
# esmatlas (public API) | local | hpc
DESIGNAGENT_FOLD_BACKEND=esmatlas

# --- enzyme redesign protocol -----------------------------------------------
# Where the campaign's files and tools live on the cluster. Every one of these
# names a path or a shell word the server will run on the endpoint, under the
# site's allocation, so all of them are environment-only: `/api/settings`
# reports them and refuses to write them, exactly like MPNN_COMMAND above.
# Unset means the protocol refuses by naming what is missing rather than
# submitting a job against a path nobody configured.
#
# plans/AMAREL_ENDPOINT.md is how the endpoint these go with gets stood up.
# The values commented out below are the Amarel ones, for shape.
DESIGNAGENT_PROTOCOL_PROJ_ROOT=
# DESIGNAGENT_PROTOCOL_PROJ_ROOT=/projects/f_sdk94_1/Stabilization/Targets/JGI_Fall_2026
# AlphaFold3 writes gigabytes per design, so its inputs and outputs go to
# scratch rather than to /projects: <root>/<netid>/af3/<campaign>.
DESIGNAGENT_PROTOCOL_SCRATCH_ROOT=/scratch

# Conda environments, used by putting their bin on PATH rather than by
# `conda activate`: a login shell reads .bash_profile, not .bashrc, so `conda`
# may not be a shell function at the far end at all.
DESIGNAGENT_PROTOCOL_CONDA_AIFOLD=
# DESIGNAGENT_PROTOCOL_CONDA_AIFOLD=/projects/f_sdk94_1/conda/envs/aifold
DESIGNAGENT_PROTOCOL_CONDA_ANALYSIS=
# DESIGNAGENT_PROTOCOL_CONDA_ANALYSIS=/projects/f_sdk94_1/conda/envs/shared_als515

DESIGNAGENT_PROTOCOL_MPNN_PATH=
# DESIGNAGENT_PROTOCOL_MPNN_PATH=/projects/f_sdk94_1/Tools/ProteinMPNN
# HaloMPNN's weights. Without these the HaloMPNN half of each round is refused.
DESIGNAGENT_PROTOCOL_MPNN_WEIGHTS=
# DESIGNAGENT_PROTOCOL_MPNN_WEIGHTS=/projects/f_sdk94_1/all239/MPNN_weights
# What HHblits searches.
DESIGNAGENT_PROTOCOL_UNIREF_DB=
# DESIGNAGENT_PROTOCOL_UNIREF_DB=/projects/f_sdk94_1/Uniref30/UniRef30_2023_02

# Comma-separated `module load` lines, not a list: pydantic-settings would
# demand JSON in the environment variable. The module sets $CONTAINERDIR,
# $ALPHAFOLD_MODELWEIGHTS and $ALPHAFOLD_DATA_PATH, which the job then binds.
DESIGNAGENT_PROTOCOL_AF3_MODULES=
# DESIGNAGENT_PROTOCOL_AF3_MODULES=module load apptainer/1.2.5,module load alphafold/vs3.0.0-pgarias
DESIGNAGENT_PROTOCOL_AF3_IMAGE=alphafold3.sif
DESIGNAGENT_PROTOCOL_GPU_QUEUE=gpu
# A Slurm --constraint word. It has no PSI/J resource field, so it travels in
# custom_attributes; see tasks/hpc/orbit.py::to_psij_spec.
DESIGNAGENT_PROTOCOL_GPU_CONSTRAINT=
# DESIGNAGENT_PROTOCOL_GPU_CONSTRAINT=ampere|adalovelace

# Where the enzyme-redesign-protocol skill is checked out, so the install stage
# can carry its scripts to the cluster. Deliberately not vendored into this
# repo: copying them in would fork them, and plans/BACKLOG.md records one place
# where this repo's port and the skill's original already disagree.
DESIGNAGENT_PROTOCOL_SCRIPTS_DIR=
# DESIGNAGENT_PROTOCOL_SCRIPTS_DIR=../enzyme-redesign-protocol/scripts
